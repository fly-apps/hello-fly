<button type="button" class="copy" data-copy="<%= value %>" aria-label="Copy <%= label %>">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon-copy">
    <rect x="9" y="9" width="12" height="12" rx="2.5"></rect>
    <path d="M5 15H4.5A2.5 2.5 0 0 1 2 12.5v-8A2.5 2.5 0 0 1 4.5 2h8A2.5 2.5 0 0 1 15 4.5V5"></path>
  </svg>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon-check">
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
</button>
